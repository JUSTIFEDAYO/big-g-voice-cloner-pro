# ==============================================================
# BIG G'S VOICE CLONER PRO - Example Production Configuration
# Copy this file to .env and configure your production values.
# NEVER commit your actual .env file or production secrets to git!
# ==============================================================

# Session & JWT Security (REQUIRED: generate with `python -c "import secrets; print(secrets.token_hex(32))"`)
JWT_SECRET=your_long_random_jwt_secret_hex_string_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=72

# Production Domain / CORS
# Comma-separated list of trusted origins (e.g., https://your-app.onrender.com)
ALLOWED_ORIGINS=https://big-g-voice-cloner-pro.onrender.com,http://localhost:7860,http://127.0.0.1:7860

# Secure Admin Bootstrap / Promotion (Optional)
# If provided, an account with this email is granted the 'admin' role on startup with 999,999 credits.
# If ADMIN_INITIAL_PASSWORD is also set and the account is newly created, it uses this password.
# Leave blank after provisioning or change password in-app.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Dual-Engine Voice Cloning Inference
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free

# Free Email Delivery (Gmail SMTP or Custom SMTP Host)
# Note: For Gmail, SMTP_USER is your Gmail address and SMTP_PASSWORD must be a 16-character
# Google App Password generated at: https://myaccount.google.com/apppasswords (NOT your main Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Persistent Storage Mount Path (Optional: only set if using a Render persistent disk or volume)
# e.g., /var/data
PERSISTENT_DATA_DIR=

# Turso Cloud SQLite (Recommended for Free Tier Persistence)
# Get free cloud SQLite database from https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
